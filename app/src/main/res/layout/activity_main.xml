<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D1117"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#161B22"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="RantingPohonTools"
            android:textColor="#E6EDF3"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvTotalChars"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#21262D"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="0 karakter"
            android:textColor="#3FB950"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Source Switcher -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingTop="10dp">

        <Button
            android:id="@+id/btnTabGithub"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:backgroundTint="#238636"
            android:text="GitHub Repo"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnTabLocal"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:backgroundTint="#21262D"
            android:text="Local Storage"
            android:textAllCaps="false"
            android:textColor="#8B949E"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- GitHub Panel -->
    <LinearLayout
        android:id="@+id/panelGithub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingTop="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etRepoUrl"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:background="#161B22"
                android:hint="https://github.com/user/repo"
                android:inputType="textUri"
                android:paddingHorizontal="12dp"
                android:singleLine="true"
                android:textColor="#E6EDF3"
                android:textColorHint="#484F58"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnScanGithub"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginStart="8dp"
                android:backgroundTint="#238636"
                android:text="Scan"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>

        <EditText
            android:id="@+id/etGithubToken"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="6dp"
            android:background="#161B22"
            android:hint="GitHub Token (opsional, untuk repo privat)"
            android:inputType="textPassword"
            android:paddingHorizontal="12dp"
            android:singleLine="true"
            android:textColor="#E6EDF3"
            android:textColorHint="#484F58"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Local Storage Panel -->
    <LinearLayout
        android:id="@+id/panelLocal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingTop="8dp"
        android:visibility="gone">

        <Button
            android:id="@+id/btnPickFolder"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:backgroundTint="#1F6FEB"
            android:text="Pilih Folder dari Storage HP"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvLocalPath"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Belum ada folder dipilih"
            android:textColor="#8B949E"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Filter & Selection Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingTop="8dp">

        <EditText
            android:id="@+id/etSearch"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:background="#161B22"
            android:hint="Cari nama file atau ekstensi (.kt, .xml)..."
            android:paddingHorizontal="12dp"
            android:singleLine="true"
            android:textColor="#E6EDF3"
            android:textColorHint="#484F58"
            android:textSize="12sp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/cbAutoIgnore"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:buttonTint="#238636"
                    android:checked="true"
                    android:text="Auto-Ignore (.git/build)"
                    android:textColor="#C9D1D9"
                    android:textSize="11sp" />

                <CheckBox
                    android:id="@+id/cbCodeOnly"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="8dp"
                    android:buttonTint="#238636"
                    android:checked="true"
                    android:text="Code Only"
                    android:textColor="#C9D1D9"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnSelectAll"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="8dp"
                    android:backgroundTint="#21262D"
                    android:minWidth="0dp"
                    android:paddingHorizontal="10dp"
                    android:text="All"
                    android:textAllCaps="false"
                    android:textColor="#E6EDF3"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnDeselectAll"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="4dp"
                    android:backgroundTint="#21262D"
                    android:minWidth="0dp"
                    android:paddingHorizontal="10dp"
                    android:text="None"
                    android:textAllCaps="false"
                    android:textColor="#E6EDF3"
                    android:textSize="11sp" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- Status / Loading -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="14dp"
        android:paddingVertical="4dp"
        android:text="Siap memindai repository atau folder lokal."
        android:textColor="#8B949E"
        android:textSize="11sp" />

    <!-- Tree List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvTree"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="8dp"
        android:paddingBottom="8dp" />

    <!-- Bottom Action Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#161B22"
        android:orientation="horizontal"
        android:padding="10dp">

        <Button
            android:id="@+id/btnCopyTree"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:backgroundTint="#21262D"
            android:text="Copy Tree"
            android:textAllCaps="false"
            android:textColor="#E6EDF3"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnCopyFull"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginHorizontal="4dp"
            android:layout_weight="1.3"
            android:backgroundTint="#238636"
            android:text="Copy Tree + Code"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnExportTxt"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginStart="4dp"
            android:layout_weight="0.9"
            android:backgroundTint="#1F6FEB"
            android:text="Export .txt"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/studioRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D1117"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#161B22"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <Button
            android:id="@+id/btnBackStudio"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:backgroundTint="#21262D"
            android:minWidth="0dp"
            android:paddingHorizontal="10dp"
            android:text="← Kembali"
            android:textAllCaps="false"
            android:textColor="#E6EDF3"
            android:textSize="12sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="GitHub Repo Studio"
            android:textColor="#E6EDF3"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnStudioUploadFile"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginEnd="6dp"
            android:backgroundTint="#1F6FEB"
            android:minWidth="0dp"
            android:paddingHorizontal="10dp"
            android:text="Upload"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnStudioNewFile"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:backgroundTint="#238636"
            android:minWidth="0dp"
            android:paddingHorizontal="12dp"
            android:text="+ File Baru"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Token & Pilih Repo -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingTop="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etStudioToken"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="#161B22"
                android:hint="GitHub Token (otomatis tersimpan)"
                android:inputType="textPassword"
                android:paddingHorizontal="12dp"
                android:singleLine="true"
                android:textColor="#E6EDF3"
                android:textColorHint="#484F58"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnStudioPickRepo"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:backgroundTint="#1F6FEB"
                android:text="Pilih Repo"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvActiveRepo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#161B22"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:text="Belum ada repository dipilih"
            android:textColor="#58A6FF"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnStudioBranch"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:backgroundTint="#21262D"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Branch: -"
                android:textAllCaps="false"
                android:textColor="#58A6FF"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnStudioRename"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginStart="8dp"
                android:backgroundTint="#21262D"
                android:paddingHorizontal="10dp"
                android:text="Rename"
                android:textAllCaps="false"
                android:textColor="#E6EDF3"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnStudioActions"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginStart="6dp"
                android:backgroundTint="#21262D"
                android:paddingHorizontal="8dp"
                android:text="Build / APK"
                android:textAllCaps="false"
                android:textColor="#3FB950"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnStudioCommits"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginStart="6dp"
                android:backgroundTint="#21262D"
                android:paddingHorizontal="8dp"
                android:text="Commit"
                android:textAllCaps="false"
                android:textColor="#D2A8FF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <EditText
            android:id="@+id/etStudioSearch"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="6dp"
            android:background="#161B22"
            android:hint="Cari file di repository untuk diedit..."
            android:paddingHorizontal="12dp"
            android:singleLine="true"
            android:textColor="#E6EDF3"
            android:textColorHint="#484F58"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvStudioStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp"
        android:text="Pilih repository terlebih dahulu, lalu ketuk file untuk mengedit."
        android:textColor="#8B949E"
        android:textSize="11sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvStudioTree"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="8dp"
        android:paddingBottom="8dp" />
</LinearLayout>
